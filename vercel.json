{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    },
    "api/ml.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(.*\\.php)", "dest": "/api/index.php?route=$1" },
    { "src": "/", "dest": "/api/index.php?route=/index.php" }
  ]
}
